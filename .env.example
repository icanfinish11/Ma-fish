NODE_ENV=development
PORT=3000

# 运行时使用最小权限角色 app_user，绝不用迁移属主角色（见 C7 与 infra/db/roles.sql）
DATABASE_URL=postgresql://app_user:CHANGE_ME@127.0.0.1:5432/vca
# 迁移专用：只被 apps/api/prisma.config.ts 读取（Prisma 7 的 schema.prisma 内已无 url）。
# 它必须指向属主角色 vca_owner——迁移要建 schema、建表、改结构，那是 app_user 没有的权限。
# **运行期绝不使用本变量**：属主对表永远保有全部权限，一旦运行期用属主，append-only 的
# REVOKE 就变成空操作（不变式 #5、C7 会静默失效）。
MIGRATE_DATABASE_URL=postgresql://vca_owner:CHANGE_ME@127.0.0.1:5432/vca
# 仅**本地开发**：允许在缺少 MIGRATE_DATABASE_URL 时回落到 compose 的兜底连接串
# （postgresql://vca_owner:owner_pw@127.0.0.1:5432/vca）。上面的模板口令是 CHANGE_ME，
# 照抄跑不通本机 compose，于是本地要么手工把那行改成 owner_pw，要么打开下面这个开关。
# **部署环境绝不打开它**：缺变量时必须报错，而不是把迁移悄悄打到 localhost。
# MIGRATE_ALLOW_LOCAL_FALLBACK=1
REDIS_URL=redis://127.0.0.1:6379

# express 的 trust proxy：决定 `req.ip` 是「socket 对端」还是「X-Forwarded-For 里的值」。
# **IP 维度的限流（注册 3 次/小时、登录 5 次/15 分钟）完全依赖它**：信任谁，谁就能影响
# 自己的限流桶。默认 loopback = 只信任同机反代（远端直连伪造不了 XFF）。
# 反代在别的机器/容器网段时改这里（CIDR 或跳数，逗号分隔），例如 TRUST_PROXY=172.18.0.0/16。
# 直连暴露（前面没有反代）用 TRUST_PROXY=false；true 表示信任所有，只在应用除反代外不可达时用。
# TRUST_PROXY=loopback

# 32 字节的 hex（64 位），用于制品 AES-256-GCM 加密；绝不入库不入 git
MASTER_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# GitHub OAuth App（发布者登录必需，§4.2）
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=no-reply@example.com
