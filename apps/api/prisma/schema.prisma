// Prisma 7 起 `datasource` 内**不允许**出现 `url`：连接串只在 `prisma.config.ts`
// （迁移期，属主角色）与运行期 driver adapter（`PrismaService`，`app_user` 角色）里出现。
// `multiSchema` 自 Prisma 7 已 GA，无需 `previewFeatures`。
//
// ── 时间戳的表示（C6，**后续所有模块必须沿用**）──────────────────────
// 本仓库**每一个** `DateTime` 字段一律写 `@db.Timestamptz(3)`，即 PostgreSQL 的
// `timestamptz`（timestamp **with** time zone）。这一条从本迁移起就是全仓约定，
// P2 的账本、P4 的竞价等后续模块照抄，不要再出现裸的 `DateTime`。
//
// 为什么不能用 Prisma 的默认 `timestamp(3)`（without time zone）——实测与语义两条：
//   * `CURRENT_TIMESTAMP` 与携带偏移量的输入都是**按会话 `TimeZone` 求值**的。裸
//     `timestamp` 列不带时区，于是「数据库默认值」与「Prisma 写入的 Date」都会被折算成
//     **本地墙上时间**存进去，UTC 只在会话恰好是 UTC 时才成立——今天绿只是因为镜像默认 UTC。
//   * `timestamptz` 存的是绝对时刻（内部按 UTC 存），读回来时区语义明确，C6「全 UTC」才
//     是可验证的而不是靠环境的巧合。
// 另外 `infra/docker-compose.yml` 给 Postgres 显式设了 `TZ: UTC` 作纵深防御，本地与 CI 一致。
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// `schemas` 是 `prisma migrate diff --from-config-datasource` 的**可见性边界**：
// 不在这里列出的 schema 对它**结构性失明**（整个 schema 连表带触发器一起不存在，
// 它照样报 `No difference detected.`——P2 / Task 1 的决定性实测，
// 见 docs/superpowers/notes/2026-10-06-p2-migration-drift.md §2）。
// 因此**新增一个模块 schema 时，把名字加进这一行与声明它的 model 必须在同一个提交里**。
datasource db {
  provider = "postgresql"
  schemas  = ["auth", "audit", "notify", "asset", "ledger", "exchange"]
}

// ── auth ──────────────────────────────────────────────────────────
// 可读写模块（改密、注销需要 UPDATE/DELETE），非 append-only。
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  role         String   @default("USER")
  creditScore  Int      @default(100) @map("credit_score")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities Identity[]

  @@schema("auth")
  @@map("users")
}

model Identity {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String
  externalId String   @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, externalId])
  @@schema("auth")
  @@map("identities")
}

// ── audit ── append-only（C7）────────────────────────────────────
// 运行期角色在 `audit` schema 上只有 SELECT + INSERT；UPDATE/DELETE 由
// `infra/db/apply-grants.sql` 显式撤销，并由 tests/integration/db/append-only.test.ts 守住。
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  traceId    String?  @map("trace_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@schema("audit")
  @@map("audit_logs")
}

// ── notify ── transactional outbox（C15）─────────────────────────
// `abandoned_at`（修复轮 1 / Fix 1）：到达重试上限而**放弃**的终止标记。
// 为什么要单独一列而不是复用 `processed_at`：消费者退出待处理集合靠 `processed_at`，
// 但那个字段单独存在时**区分不出**「投递成功」与「试了 N 次后放弃」——运维拿到的会是
// 「已处理」这个错误结论（一封其实没发出去的邮件看起来像发出去了）。
// 约定：`processed_at` 非空 且 `abandoned_at` 为空 = 投递成功；两者都非空 = 放弃。
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  topic          String
  payload        Json
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  abandonedAt    DateTime? @map("abandoned_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")

  @@index([processedAt, createdAt])
  @@schema("notify")
  @@map("outbox_events")
}

// ── notify ── 幂等消费记录（§8.5）───────────────────────────────
// 注：`idempotency_key` 同时是主键，因为幂等键本身即该表的唯一身份；
// Prisma 要求每个 model 至少有一个 `@id` 或 `@unique` 字段，此处标 `@id`。
model ProcessedJob {
  idempotencyKey String   @id @map("idempotency_key")
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@schema("notify")
  @@map("processed_jobs")
}

// ── asset ── 作品 / 版本 / 元数据 / 所有权历史（P1 Task 7；设计 D11 + D12）──
//
// 本 schema 是 `asset` 模块**独占**的（C5）：跨模块不 join、不直写别人的表，
// 需要别的模块的东西时走显式接口 + DTO。
//
// ## 为什么这几张表里**没有**指向 `auth.users` 的外键
//
// `owner_id` / `uploaded_by_id` / `from_user_id` / `to_user_id` 都是用户的 UUID，
// 但它们**刻意不建**跨 schema 外键：那会在数据库层把两个模块钉在一起（删一个用户要
// 级联到谁的哪张表、迁移顺序被另一个模块的 schema 绑住），而 C5 要的正是相反的
// 东西——归属由调用方给出的 UUID 表达，跨模块的约束留在接口层。
// 本 schema **内部**的外键（version → asset、metadata → version、history → asset）
// 都建了：它们是同一个模块自己的完整性，与 C5 不冲突。

/// 作品（**永久实体**，设计 §5.2 第 1 条）：有版本史与所有权史。
/// `Asset` ≠ `Listing`（上架是可反复的状态，P2），因此这里没有价格/状态字段（C16）。
model Asset {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// 当前所有人。转让就是改**这一个指针**（§5.2 第 2 条），制品一个字节都不动。
  ownerId   String   @map("owner_id") @db.Uuid

  /// ★ **交换锁定**（P3 / Task 2；设计 §6.3:284「双方均锁定（资产变为不可编辑 /
  /// 不可另行上架 / 不可删除）」）。
  ///
  /// ## 为什么锁在**作品**行上，而不是合约行上
  /// §6.3:284 那三个谓词的作用对象是**作品**。合约上的两个确认时间戳只记「谁在什么时候
  /// 按了确认」，**两处一起**才表达得出「双方均锁定」；把锁写成合约上的一个布尔值，
  /// 会让「这份作品现在能不能编辑」这个问题无法回答（一张作品可能同时出现在多份合约里）。
  ///
  /// ## 为什么是可空时间戳而不是布尔
  /// 「锁了」与「谁在什么时候锁的」是同一个事实的两面，而排查一次锁死事故时后者才是有用的
  /// 那个；`null` 与 `非 null` 已经提供了布尔语义，再加一列是重复表达（C16）。
  ///
  /// 见证：`tests/integration/db/exchange-enforcement.test.ts` 的
  /// 「`asset.assets.locked_at`」那一条（列的形状 + 运行期角色锁得动、放得开两个方向）。
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  versions         AssetVersion[]
  ownershipHistory OwnershipHistory[]

  // 刻意**没有** `@@index([ownerId])`：今天没有任何查询按所有人过滤
  // （接入期按 assetId 写、转让按主键更新、`checkAccess` 按主键读），
  // 建一个没人用的索引是 C16 说的「为不存在的调用方预埋」。

  @@schema("asset")
  @@map("assets")
}

/// 一个版本 = 一份加密制品 + 它的身份（设计 §5.1「加密制品包」）。
model AssetVersion {
  id      String @id @default(uuid(7)) @db.Uuid
  assetId String @map("asset_id") @db.Uuid

  /// 明文（上传字节）的 sha256，hex。**不是**制品的摘要。
  sha256 String

  /// 制品库里的对象键。**下载路径必须靠它取对象**——P1 计划的字段清单里原本漏了它，
  /// Task 5 发现并移交（Task 5 报告 §12 Concern 2）：没有它，版本记录指向不了任何制品。
  storageKey String @map("storage_key")

  /// **制品自称的明文长度之外的**那个数：由 Task 5 的**写入侧计量器**在加密那一趟里数出来
  /// （`ArtifactWriteReceipt.plaintextBytes`），**不是**密文对象的字节数、也不是上传元数据。
  ///
  /// 为什么它是承重列而不是可选元数据：制品格式里**没有任何字段认证「制品有多长」**
  /// （`plaintextLength` 在尾部、不进任何 AAD），所以这条核对只能靠带外的这个数。
  /// Task 5 的探针 m6 实测：不传带外长度时，一份**更短、完全自洽**的制品被接受（201）；
  /// 带上它就是 422。**Task 8 必须在下载路径把它作为 `expectedPlaintextLength` 传回读取器**，
  /// 否则这条核对只在接入期有效，下载路径上「更短、完全自洽」的制品会被当成合法的。
  ///
  /// 类型是 `Int`（int4）而不是 `BigInt`：上限由 D6 的 1 GiB 结构性给出（远小于 int4 的
  /// 2^31-1），且写入侧的来源本身就是一个 JS `number`——用 bigint 只会让每一处边界
  /// 多一次 `Number()`/`BigInt()` 转换，而那是会丢精度的形状（C16：不为不存在的规模付代价）。
  plaintextBytes Int @map("plaintext_bytes")

  /// 写入时用的制品密钥 id（= 制品头里的那个）。轮换靠它选键：旧制品按自己的 keyId 仍可读。
  keyId String @map("key_id")

  /// 制品头里的 fileId（hex）。AAD 绑定它，因此它是「这份制品」的身份的一部分。
  fileId String @map("file_id")

  /// 上传人。匿名/系统导入为 NULL —— Task 5 的 `IngestedVersion.uploadedById` 就是
  /// `string | null`，这一列的可空性是照着它来的，不是猜的。
  uploadedById String? @map("uploaded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  asset    Asset          @relation(fields: [assetId], references: [id])
  metadata AssetMetadata?

  // 同样**没有** `@@index([assetId])`：今天唯一的读法是「按版本 id 取一份」（下载路径），
  // 那是主键。列表页出现时再加索引——那时它是被一个真实查询逼出来的。

  @@schema("asset")
  @@map("asset_versions")
}

/// 元数据（Task 6 的 `ParsedMetadata`，纯静态解析的产物；D9）。
///
/// `asset_version_id` **同时是主键**：一行元数据描述且只描述一个版本（1:1），
/// 与 P0 的 `ProcessedJob` 用幂等键作主键同一条理由——它的身份就是被描述的那个对象，
/// 再发一个代理键只会多一个「同一版本两行元数据」的可能。C4 也没有被绕过：
/// 这个值本身就是 UUIDv7（来自 `asset_versions.id`）。
model AssetMetadata {
  assetVersionId String @id @map("asset_version_id") @db.Uuid

  /// README 的截断摘录；没有 README 时是 NULL（「没有」与「空文件」不是同一件事，
  /// Task 6 §3.1 有用例）。**绝不执行**其中任何内容（C2）。
  readmeExcerpt String? @map("readme_excerpt")

  /// 文件树摘要 `[{ path, bytes }]`（只有文件；深度与条目数都受限）。
  fileTree Json @map("file_tree")

  /// 语言分布 `[{ name, bytes, ratio }]`（按字节降序）。
  languages Json

  /// 依赖清单 `[{ ecosystem, name, version }]`（纯文本解析，绝不为它跑包管理器）。
  dependencies Json

  /// 完整度评分 0–100（设计 §6.2；权重可配，默认权重合计 100）。
  completeness Int

  /// 文件树是否**被截断**（深度或条目数上限）。Task 6 明说这是 brief 契约的**超集**：
  /// 数组本身放不下这个事实，而「截断了却看不出」会让预览资料谎报项目规模。
  fileTreeTruncated Boolean @map("file_tree_truncated")

  assetVersion AssetVersion @relation(fields: [assetVersionId], references: [id])

  @@schema("asset")
  @@map("asset_metadata")
}

/// 所有权流转（**append-only**，C7 / 设计 §5.3）。
///
/// 运行期角色只有 `SELECT` + `INSERT`，`UPDATE`/`DELETE` 由
/// `infra/db/apply-grants.sql` 显式撤销（**两个角色**才让它生效：属主对自己的 REVOKE 是
/// 空操作），回归在 `tests/integration/db/append-only.test.ts`。
/// 因此写进来的行**删不掉也改不了**——这正是所有权史的全部价值。
model OwnershipHistory {
  id      String @id @default(uuid(7)) @db.Uuid
  assetId String @map("asset_id") @db.Uuid

  /// 前手。**非空**：转让总是从「当前所有人」出发（`Asset.ownerId` 在同一事务里读出），
  /// 因此这一列在任何一条转让记录上都有值。「作品诞生」不是转让，今天没有任何写入方
  /// 写它（C16：不为一种不存在的写入形态放宽约束）。
  fromUserId String @map("from_user_id") @db.Uuid

  /// 后手。转让的判据就是它成为 `Asset.ownerId`。
  toUserId String @map("to_user_id") @db.Uuid

  /// 事由（交易所致、裁决所致、管理动作…）。**原文落库**：append-only 的行删不掉，
  /// 因此这里只放业务事由，绝不放凭证/令牌（C11）。
  reason String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id])

  /// 唯一的读法是「某个作品的所有权史，按时间」，因此索引就是那个读法的形状。
  @@index([assetId, createdAt])
  @@schema("asset")
  @@map("ownership_history")
}

// ── ledger ── 复式记账（P2 / Task 4；设计 §8）─────────────────────────
//
// 三张表就是账本的全部：账户（物化余额）、交易（幂等键的载体）、分录（append-only 的事实）。
// **刻意没有** `currency` 列（D1：C16 + MVP 单币种）、**刻意没有** `EscrowRecord`
// （D3：冻结分录本身就是托管记录，`EscrowRecord` 属 P3 的 Order）。
//
// ## 这个 schema 里的强制点分成两半，**两半的见证方式不同**
//
//   * **Prisma 建得出来的那半**（表 / 列 / 索引 / 外键 / 唯一约束）由 `migrate diff`
//     的零漂移门见证——它比的是库与模型。
//   * **Prisma 表达不了的那半**（延迟约束触发器、条件化 CHECK、非零 CHECK、系统账户种子）
//     **只有真库能见证**。实测：库里挂着手写 plpgsql 函数 + `DEFERRABLE INITIALLY DEFERRED`
//     约束触发器 + `CHECK` 时，`migrate diff` 照样报 `No difference detected.`
//     （`docs/superpowers/notes/2026-10-06-p2-migration-drift.md` §3）。
//     因此**不要**把零漂移门读成「手写 DDL 还在」；那半的证据在
//     `tests/integration/db/ledger-enforcement.test.ts`
//     （`pg_proc` / `pg_trigger` / `pg_get_constraintdef` 目录断言 + 行为用例）。
//
// ## 为什么账户没有跨 schema 外键指向 auth.users
// 与 P1 的 asset schema 同一条理由（C5）：归属由调用方给出的 UUID 表达，
// 跨模块的约束留在接口层。

/// 一个账户 = (kind, owner)。**用户账户惰性创建**；**系统账户由迁移种子化恰好一次**（D2）。
model LedgerAccount {
  id String @id @default(uuid(7)) @db.Uuid

  /// `USER_AVAILABLE` / `USER_FROZEN` / `PLATFORM_ESCROW` / `PLATFORM_REVENUE` / `EXTERNAL_TOPUP`
  /// ——**只有这五个**（§8.1）。§8.2 里的 `SELLER_AVAILABLE` 之流是「另一个用户的
  /// `USER_AVAILABLE`」，**不是**新的 kind（C30）。取值集合的定义处是
  /// `core/account-kind.ts`（Task 5）。
  kind String

  /// 用户账户的当事人；系统账户为 NULL。**不变式 #3 只约束有 owner 的那两种 kind**
  /// （条件化 CHECK，见迁移），因为系统账户天然为负——实测：无条件 CHECK 会钉死充值路径。
  ownerUserId String? @map("owner_user_id") @db.Uuid

  /// 物化余额（**分**，bigint）。只由过账函数在事务内改动，且与分录同一事务（C27）。
  balance BigInt @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  /// 用户账户的 (owner, kind) 唯一 ⇒ 惰性创建的 `ON CONFLICT DO NOTHING` 有约束可依
  /// （实测三次并发 → 1/0/0）。
  ///
  /// **注意它对系统账户不成立**：PostgreSQL 的唯一索引把 NULL 视为互不相同，
  /// 因此 (NULL, 'PLATFORM_ESCROW') 可以出现多行。这正是系统账户**不用**惰性创建、
  /// 而由迁移种子化恰好一次的原因（D2）；「恰好三个系统账户」由
  /// `tests/integration/db/ledger-enforcement.test.ts` 的一条计数断言守住。
  @@unique([ownerUserId, kind])
  @@schema("ledger")
  @@map("accounts")
}

/// 一笔过账（复式记账的「交易」）。幂等键的唯一约束在这里（C26 / §8.5）。
model LedgerTransaction {
  id String @id @default(uuid(7)) @db.Uuid

  /// 业务类型：`TOPUP` / `FREEZE` / `UNFREEZE` / `ESCROW_LOCK` / `ESCROW_RELEASE`
  /// （§8.2 的行；取值集合见 `core/types.ts`，Task 5）。
  kind String

  /// **幂等键**（§8.5「每个 Worker 任务有幂等键」）。唯一约束是它的执行点：
  /// 重复得到可判别的 P2002，而**不是**被 upsert 静默去重（P0 的 `OutboxService`
  /// 已经立了同款规矩：重复发布是调用方需要知道的事实）。
  idempotencyKey String @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@schema("ledger")
  @@map("transactions")
}

/// 分录（**append-only**，C7 / 不变式 #5）。
///
/// `amount` 的符号约定（全账本唯一一处定义）：**正 = 贷（该账户余额增加），负 = 借（减少）**。
/// 因此 §8.2 的 `DR X CR Y` 记作 `X: -a`、`Y: +a`，而「每笔交易 Σ = 0」就是不变式 #1。
model LedgerEntry {
  id            String @id @default(uuid(7)) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  accountId     String @map("account_id") @db.Uuid

  /// 有符号的「分」。`<> 0` 由迁移里的行级 CHECK 强制（一笔交易在某个账户上的净额不得为 0）。
  amount BigInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  /// 这条索引是**被一个真实查询逼出来的**：延迟约束触发器在 COMMIT 时按 `transaction_id`
  /// 聚合（`AFTER ROW` 逐行触发 ⇒ 20 条腿 20 次聚合）。预检 §C.18 的实测开销
  /// （10 腿 11.4 ms / 200 腿 35.5 ms）就是在这条索引下量的。
  @@index([transactionId])

  /// ★ P3 / Task 2（控制器裁定 ⑥）：**逐账户对账的使能条件**。
  ///
  /// P3 预检实测：逐账户对账**已经可行**（20 万行 / 1 万账户 40 ms），**但执行计划是
  /// `Seq Scan on entries`**——`entries` 上当时只有 `entries_pkey` 与
  /// `entries_transaction_id_idx`。为一个**已交付的功能**（Task 5 的 `reconcilePerAccount`）
  /// 加索引不是投机抽象，是它的使能条件。
  ///
  /// 注意这条索引**不是**为过账路径加的：过账按账户 id 做的是**主键**条件更新，
  /// 那条路径今天就走索引。
  ///
  /// 见证：`tests/integration/db/exchange-enforcement.test.ts` 的
  /// 「`ledger.entries(account_id)` 索引在」那一条（`pg_indexes` 的 `indexdef` 逐字）。
  @@index([accountId])
  @@schema("ledger")
  @@map("entries")
}

// ── exchange ── 交换（P3 / Task 2；设计 §6）────────────────────────────
//
// 三张表 + 它们的约束就是交换的全部状态：要约（谁向谁提了什么）、合约（互换的进行时）、
// 义务（这份合约欠多少钱 —— 不变式 #4 的右式）。
//
// ## 刻意**没有**什么
//   * 没有 `Listing` 表：§5.2 第 1 条说 `Asset ≠ Listing`，而 §2.1 的 P3 行只写「上架（交换）」
//     ——「上架」在交换语境里的**全部可观测后果**就是「有一份 `ACTIVE` 的要约指向它」。
//     为 P4 的拍卖建一张真正的 `Listing` 时再抽（C16）。
//   * 没有 `Dispute` 表：§2.1 把「争议仲裁」归 **P6**；P3 的争议是合约上的一个状态
//     （`DISPUTED`），D18 逐字说明了这个划界。
//   * 没有「交换 → 拍卖升级」的任何列：§6.5 明写它 **P3.5 延后**（D15 / C16）。
//
// ## 没有跨 schema 外键
// 与 `asset` / `ledger` 同一条理由（C5）：`proposer_id` / `counterparty_id` / `asset_*_id`
// 都是别的 schema 的 UUID，归属由调用方给出的值表达，跨模块约束留在接口层。
// 本 schema **内部**的两条外键（contract → offer、obligation → contract）都建了：
// 它们是同一个模块自己的完整性。
//
// ## 手写的部分不在这个文件里（**别把 P2 的边界照抄过来，也别反过来**）
// 三张表的表 / 列 / 索引 / 唯一约束都是 Prisma 建得出来的，因此零漂移门在这三张表上
// **是真的见证**；但迁移里另有六条 `CHECK`（两张状态机的取值闭集 + 金额取值域 +
// 一条条件化 CHECK），`prisma migrate diff` 对它们**结构性失明**——Task 2 用探针 S-2
// 在本迁移上重测过（删掉一条 CHECK 之后 `migrate diff --exit-code` 照样以 0 退出）。
// 那六条的唯一机器见证是 `tests/integration/db/exchange-enforcement.test.ts`
// 的 `pg_get_constraintdef` 目录断言。

/// 交换要约（§6.3 的第一个状态机）。
model SwapOffer {
  id String @id @default(uuid(7)) @db.Uuid

  /// 发起方。**必须是 `targetAssetId` 的当前所有人**（`proposeOffer` 里判，Task 6）。
  proposerId String @map("proposer_id") @db.Uuid

  /// 发起方拿出来的那件作品。
  offeredAssetId String @map("offered_asset_id") @db.Uuid

  /// 被要约的那件作品。**它的所有人 = 被要约方**（`counterpartyId` 在创建时由它派生）。
  targetAssetId String @map("target_asset_id") @db.Uuid

  /// 被要约方。冗余存一列的理由：每一次鉴权（`swapOfferSent` 条件）都要问
  /// 「我是不是对手方」，而按 `targetAssetId` 反查 `asset.assets.owner_id` 会**跨模块**
  /// （C5 禁止）。它是**创建那一刻的**所有人快照——作品此后转让不会改这一列，
  /// 而那正是我们要的：要约是对**那个人**发出的。
  counterpartyId String @map("counterparty_id") @db.Uuid

  /// `DRAFT` / `SENT` / `ACCEPTED` / `REJECTED` / `WITHDRAWN` / `EXPIRED`（§6.3）。
  /// 取值集合的定义处是 `core/types.ts`（Task 3）；迁移里有 `CHECK` 把它钉住，
  /// **注意边界**：CHECK 保证「取值在闭集内」，**不**保证「迁移是合法的」——
  /// 后者是 `core/state-machine.ts` 的迁移表（Task 3）。
  status String @default("SENT")

  /// 拒绝 / 撤回的理由（**原文落库**；与 `ownership_history.reason` 同一纪律：只放业务事由，
  /// 绝不放凭证/令牌，C11）。
  reason String?

  /// 72 小时有效期（§6.3:280「EXPIRED（72 小时）」）。**由服务在创建时算出并落库**
  /// （不是 `created_at + interval '72 hours'`）：契约是「要约在多长时间内有效」，
  /// 而不是「72 这个魔数出现在查询里」——将来按类别给不同期限时，改的是写入侧一处。
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// 一份要约的 1:1 合约（`ACCEPTED` 时才存在）。
  contract SwapContract?

  /// 同一对 (作品, 对手方) 上的要约唯一。这是「重复发要约」的执行点：
  /// 第二次同向要约撞唯一索引（P2002），而不是静默多出一行。
  ///
  /// **它的边界要据实写清**：
  ///   * 它只挡 `(targetAssetId, counterpartyId)` 这一对，**不挡**同一份要约被接受两次
  ///     （那由 `status` 的状态机守卫 + 合约上的 `offer_id` 唯一外键挡）；
  ///   * 它带着**状态维度缺失**的代价：`REJECTED` 之后重新发要约也会撞上它。
  ///     控制器裁定 ①（P3 计划落地时的那条）已定：唯一索引应写成**只覆盖非终态的
  ///     部分唯一索引**（`WHERE state IN (非终态集合)`）。那是一次需要同时改 model、
  ///     迁移与 `proposeOffer` 的改动，属 **Task 6** 的落点（本任务只建表，
  ///     不替它选一个会改变语义的形状）。**据实记载**：今天这里是全线唯一。
  @@unique([targetAssetId, counterpartyId])
  @@schema("exchange")
  @@map("swap_offers")
}

/// 交换合约（§6.3 的第二个状态机；**§6.3:294 的命题载体**）。
model SwapContract {
  id      String @id @default(uuid(7)) @db.Uuid
  offerId String @unique @map("offer_id") @db.Uuid

  /// 两方。`partyAId` 是被要约方（原 `targetAssetId` 的所有人），`partyBId` 是发起方——
  /// **固定下来**，因为「谁确认过锁」是两个可空时间戳而不是一个集合。
  partyAId String @map("party_a_id") @db.Uuid
  partyBId String @map("party_b_id") @db.Uuid

  /// 两件作品。**顺序无关**：`lockAssetIds()`（Task 3 的纯函数）负责把任何一对排成
  /// 全局锁序（C35），业务代码不得依赖这里的先后。
  assetAId String @map("asset_a_id") @db.Uuid
  assetBId String @map("asset_b_id") @db.Uuid

  /// `PENDING_BOTH_LOCK` / `VALIDATING` / `RELEASED` / `DISPUTED` / `SETTLED` / `CANCELLED`
  /// （§6.3 + D18 对 `DISPUTED` 的落点说明）。CHECK 钉住闭集（见迁移）。
  status String @default("PENDING_BOTH_LOCK")

  /// 补差（**分**，`bigint`，恒 `>= 0`；方向由 `topUpPayerId` 表达，不由符号表达）。
  /// `0` 表示等价互换。金额一律「分」且是 bigint（C3）；HTTP 边界上是十进制字符串（C22）。
  topUpAmount BigInt @default(0) @map("top_up_amount")

  /// 补差的付款方。冗余一列而不是靠正负号：`payerId` 与 `amount` 的符号是同一个事实的
  /// 两种表达，而**负金额**会让 C3/C22 那条契约多一个必须处理的形状（`-` 前缀在
  /// `parseMinorUnits` 里合法，但「一笔补差是负的」在业务上无意义）。
  ///
  /// 「有补差」与「有付款人」必须**同时**成立，两个方向都由迁移里的条件化 CHECK 挡
  /// （一条 `CHECK` 表达两个方向的理由：它是同一个事实的两面，拆成两条会让人以为
  /// 它们可以分别满足）。
  topUpPayerId String? @map("top_up_payer_id") @db.Uuid

  /// `PENDING_BOTH_LOCK` 的 24 小时期限（§6.3:283）。与 `SwapOffer.expiresAt` 同一理由：
  /// 由服务在创建时算出并落库，而不是让「24」这个魔数出现在查询里。
  lockDeadlineAt DateTime @map("lock_deadline_at") @db.Timestamptz(3)

  /// 双方确认锁定（§9 的 `SwapContract confirmLock`）。null = 还没确认。
  lockedByAAt DateTime? @map("locked_by_a_at") @db.Timestamptz(3)
  lockedByBAt DateTime? @map("locked_by_b_at") @db.Timestamptz(3)

  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  /// 7 天争议期的截止时刻（= `releasedAt + 7 天`）。`dueAutoConfirm` 读它（Task 3/10）。
  disputeDeadlineAt DateTime? @map("dispute_deadline_at") @db.Timestamptz(3)
  settledAt  DateTime? @map("settled_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  disputedAt  DateTime? @map("disputed_at") @db.Timestamptz(3)

  /// 争议的提出人（`DISPUTED` 时非空）。§2.1 把**裁决**归 P6，但「谁提的」是 P3 的事实。
  disputedById String? @map("disputed_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  offer      SwapOffer        @relation(fields: [offerId], references: [id])
  obligation SwapObligation?

  /// 「谁在哪份合约里」这条读法（P6 的仲裁界面、以及任何「我的合约」列表）今天**没有**
  /// 消费者，因此**不建**索引（C16）。下面这两条是被一个真实查询逼出来的：
  /// Task 10 的计时器按 `(status, lock_deadline_at)` 与 `(status, dispute_deadline_at)`
  /// 取到期集合，两条都是「按状态筛 + 按截止时刻排序」的形状。
  @@index([status, lockDeadlineAt])
  @@index([status, disputeDeadlineAt])
  @@schema("exchange")
  @@map("swap_contracts")
}

/// 托管义务（**P3 不变式 #4 的右式来源**；D2 / 控制器裁定 ⑤）。
///
/// ## 它为什么必须存在（预检 §0.3 的证伪，逐字）
///
/// 两个合约各锁 1000，其中一笔释放 **1500** ⇒ **接受**、ESCROW = 500（≥ 0）、
/// `isBalanced = true`、审计如实。**平台为该合约付出了它从未为这份合约持有的 500 分，
/// 而没有任何一条不变式看得见。** 托管只有 **1 行**账户；`entries` 只有
/// `(id, transaction_id, account_id, amount, created_at)`；`transactions` 只有
/// `kind/idempotency_key` ⇒ **「这笔钱属于哪份合约」在库里无处可查。**
///
/// 这张表就是那个「无处」。它**不记钱**（钱的唯一载体仍是账本，C27）——它记
/// 「哪份合约欠多少钱、什么状态」，于是 `Σ PLATFORM_ESCROW ≥ Σ 未结算义务` 这条不等式
/// （§8.3 不变式 #4）第一次有了**右式**。
model SwapObligation {
  id String @id @default(uuid(7)) @db.Uuid

  /// 义务的唯一身份：`('swap', contractId)`。**确定性派生**（`core/idempotency.ts`，Task 3），
  /// 因此「同一份合约登记两次」在**数据库层**被拒 —— 这正是 D3 选的形态。
  ///
  /// ## ★ 控制器裁定 ⑤：链的形态是 `(producer, key)` 唯一索引，不是 `settle:` 前缀约定
  ///
  /// 理由逐字：那个前缀今天**五处全是注释、零检查**（`ledger.service.ts:84-102`，
  /// 「声明了但未强制」那一类），而**唯一索引由数据库检查**，且它顺带吸收命名空间问题。
  /// **不做前缀校验**（D8 的据实记账）：那需要先定「谁拥有哪些前缀」（一次契约变更）。
  /// 代价如实记录：`ledger.transactions.idempotency_key` 仍是**单列**唯一索引，
  /// 因此**账本的命名空间仍然是全局的**——P3 的键一律带 `producer` 前缀（`exchange:`），
  /// 而账本侧那条约定**仍未变成守卫**（复访触发条件：出现第三个生产者时）。
  ///
  /// 见证：`tests/integration/db/exchange-enforcement.test.ts` 里那条「同一份合约登记两次
  /// 义务 ⇒ 23505」（探针 S-3 删掉索引 ⇒ 第二次 INSERT 成功 ⇒ 那条变红）。
  producer String
  key      String

  contractId String @unique @map("contract_id") @db.Uuid

  /// 义务金额（**分**，bigint，恒 `>= 0`）。0 是合法的（等价互换不产生补差义务）。
  amount BigInt

  /// `LOCKED`（已进托管、争议期内）/ `SETTLED`（已释放）。**两个值**（D2）——
  /// 多一个 `REVERSED` 都是多余：C31 决定了「争议裁决 = 一次冻结释放」，
  /// 而那个动作的账本语义与 `SETTLED` 的释放**逐字相同**（都是 `ESCROW_RELEASE`）。
  state String @default("LOCKED")

  lockedAt  DateTime  @default(now()) @map("locked_at") @db.Timestamptz(3)
  settledAt DateTime? @map("settled_at") @db.Timestamptz(3)

  contract SwapContract @relation(fields: [contractId], references: [id])

  @@unique([producer, key])
  @@schema("exchange")
  @@map("swap_obligations")
}
