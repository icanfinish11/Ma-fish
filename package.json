{
  "name": "vibe-coding-auction-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "pretest": "pnpm db:generate",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:security": "vitest run --project security",
    "test:property": "vitest run --project property --passWithNoTests",
    "test:arch": "vitest run --project architecture",
    "test:gate": "node scripts/assert-tests-ran.mjs",
    "arch": "depcruise --config .dependency-cruiser.cjs apps packages",
    "db:generate": "pnpm -r db:generate",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down -v",
    "db:grants": "docker compose -f infra/docker-compose.yml exec -T postgres psql -v ON_ERROR_STOP=1 -U vca_owner -d vca -f /opt/vca/apply-grants.sql",
    "db:setup": "pnpm db:up && pnpm --filter @vca/api db:migrate:deploy && pnpm db:grants"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
